 "sentences": [
  {
   "text": "Cette nuit-là, la pire tempête du siècle frappe l'île.",
   "words": [
    0,
    8
   ],
   "subject": "lina"
  },
  {
   "text": "Lina, onze ans, garde le dernier phare de la côte avec son grand-père.",
   "words": [
    9,
    21
   ],
   "subject": "lina"
  },
  {
   "text": "Mais ce soir, papi est malade, et au large, un bateau de pêche lutte contre les vagues.",
   "words": [
    22,
    38
   ],
   "subject": "lina"
  },
  {
   "text": "Soudain, la foudre frappe la tour, et le phare s'éteint.",
   "words": [
    39,
    48
   ],
   "subject": "lina"
  },
  {
   "text": "Sans lumière, le bateau va se briser sur les rochers.",
   "words": [
    49,
    58
   ],
   "subject": "lina"
  },
  {
   "text": "Alors Lina prend sa lanterne, et court sur la digue, sous la pluie.",
   "words": [
    59,
    71
   ],
   "subject": "lina"
  },
  {
   "text": "Elle grimpe les cent marches, une à une.",
   "words": [
    72,
    79
   ],
   "subject": "lina"
  },
  {
   "text": "Tout en haut, elle rallume la grande lampe.",
   "words": [
    80,
    87
   ],
   "subject": "lina"
  },
  {
   "text": "Le faisceau balaie la mer, et le bateau vire, juste à temps.",
   "words": [
    88,
    99
   ],
   "subject": "lina"
  },
  {
   "text": "Cette nuit-là, le dernier phare a brillé grâce à une petite fille.",
   "words": [
    100,
    111
   ],
   "subject": "lina"
  }
 ],
