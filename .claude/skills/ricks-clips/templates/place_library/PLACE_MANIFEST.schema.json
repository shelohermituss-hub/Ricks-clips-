{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricksclips.local/schemas/place-manifest-v1.json",
  "title": "RicksClips reusable place manifest",
  "type": "object",
  "required": [
    "schema_version",
    "place_id",
    "name",
    "coordinate_system",
    "visual_direction",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "place_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "coordinate_system": {
      "const": "film-plan-metres-x-y-forward-z-up"
    },
    "visual_direction": {
      "type": "object",
      "required": [
        "style",
        "palette",
        "time_of_day"
      ],
      "properties": {
        "style": {
          "type": "string"
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_of_day": {
          "type": "string"
        },
        "weather": {
          "type": "string"
        },
        "atmosphere": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "anchors": {
      "type": "object"
    },
    "camera_stations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "asset_id",
          "role",
          "license"
        ],
        "properties": {
          "provider": {
            "enum": [
              "sketchfab",
              "polyhaven",
              "ambientcg",
              "fab",
              "blenderkit",
              "manual"
            ]
          },
          "asset_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "creator": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotationY": {
            "type": "number"
          },
          "scale": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "target_materials": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Exact Three.js material names to receive PBR maps; required when role is material/texture/surface."
          },
          "repeat": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "roughnessFactor": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metalnessFactor": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "normalScale": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "receiveShadow": {
            "type": "boolean"
          },
          "castShadow": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "set_module": {
      "type": "string"
    },
    "approved_stills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
